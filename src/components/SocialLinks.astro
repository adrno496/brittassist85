---
interface Props {
  size?: number;
  variant?: 'footer' | 'inline';
}
const { size = 18, variant = 'footer' } = Astro.props;

const links = [
  {
    name: 'Instagram',
    href: 'https://www.instagram.com/brittassist85',
    label: 'Suivre Brittassist sur Instagram',
  },
  {
    name: 'Facebook',
    href: 'https://www.facebook.com/profile.php?id=100091531544199',
    label: 'Suivre Brittassist sur Facebook',
  },
  {
    name: 'LinkedIn',
    href: 'https://www.linkedin.com/in/brittassit85/',
    label: 'Suivre Brittany Dreano sur LinkedIn',
  },
];
---

<ul class={`social-links social-links--${variant}`}>
  {links.map((l) => (
    <li>
      <a
        href={l.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={l.label}
        title={l.name}
      >
        {l.name === 'Instagram' && (
          <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
        )}
        {l.name === 'Facebook' && (
          <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
          </svg>
        )}
        {l.name === 'LinkedIn' && (
          <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
            <rect x="2" y="9" width="4" height="12"/>
            <circle cx="4" cy="4" r="2"/>
          </svg>
        )}
      </a>
    </li>
  ))}
</ul>

<style>
  .social-links {
    list-style: none;
    display: flex;
    gap: 12px;
    padding: 0;
    margin: 0;
  }
  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    transition: background var(--transition), color var(--transition), transform var(--transition);
  }

  .social-links--footer a {
    background: rgba(253, 250, 247, 0.08);
    color: var(--rose-pastel);
    border: 1px solid rgba(253, 250, 247, 0.12);
  }
  .social-links--footer a:hover {
    background: var(--rose-pastel);
    color: var(--anthracite);
    transform: translateY(-2px);
  }

  .social-links--inline a {
    background: var(--blanc);
    color: var(--rose-fonce);
    border: 1px solid rgba(232, 160, 176, 0.35);
  }
  .social-links--inline a:hover {
    background: var(--rose-pale);
    border-color: var(--rose-fonce);
    transform: translateY(-2px);
  }
  :global(html.dark) .social-links--inline a {
    background: var(--dm-surface);
    border-color: rgba(232, 160, 176, 0.18);
  }
</style>
