---
interface Props {
  href?: string;
  /** ivoire / or : sur fond sombre · noir / contour : sur fond clair · lien : lien-flèche */
  variant?: 'ivoire' | 'or' | 'noir' | 'contour' | 'lien';
  external?: boolean;
  ariaLabel?: string;
  type?: 'button' | 'submit';
  classExtra?: string;
}

const {
  href,
  variant = 'ivoire',
  external = false,
  ariaLabel,
  type = 'button',
  classExtra = '',
} = Astro.props;

const base = variant === 'lien' ? 'btn-lien' : `btn btn--${variant}`;
const classes = [base, classExtra].filter(Boolean).join(' ');
---

{href ? (
  <a
    href={href}
    class={classes}
    aria-label={ariaLabel}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
  >
    <slot />
    {variant === 'lien' && <span class="arrow" aria-hidden="true">→</span>}
  </a>
) : (
  <button type={type} class={classes} aria-label={ariaLabel}>
    <slot />
    {variant === 'lien' && <span class="arrow" aria-hidden="true">→</span>}
  </button>
)}
