---
import Monogram from './Monogram.astro';
import { metiers } from '../data/metiers';
import { zones } from '../data/zones';
import { guides } from '../data/guides';
const year = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer__grid">
      <div>
        <div class="footer__brand">
          <Monogram variant="foot" />
          <span class="footer__name">BrittAssist</span>
        </div>
        <p class="footer__role">
          Executive &amp; Lifestyle Assistant.<br />
          Private Office externalisé.
        </p>
      </div>

      <nav aria-label="Liens de pied de page">
        <ul class="footer__links">
          <li><a href="/contact">Contact</a></li>
          <li>
            <a href="https://www.linkedin.com/in/brittassit85/" target="_blank" rel="noopener">
              LinkedIn
            </a>
          </li>
          <li>
            <a href="https://www.instagram.com/brittassist85" target="_blank" rel="noopener">
              Instagram
            </a>
          </li>
          <li><a href="/mentions-legales">Mentions légales</a></li>
          <li><a href="/cgv">CGV</a></li>
          <li><a href="/politique-confidentialite">Politique de confidentialité</a></li>
        </ul>
      </nav>
    </div>

    <!-- Plan du site : maillage sitewide vers les trois familles de pages
         (métier, zone, guide). C'est le principal chemin de découverte. -->
    <nav class="footer__seo" aria-label="Plan du site">
      <div class="index-prestations">
        <div class="index-groupe">
          <h3>Par métier</h3>
          {metiers.map((m) => (
            <a href={`/assistante/${m.slug}`}>{m.nom}</a>
          ))}
        </div>
        <div class="index-groupe">
          <h3>Zones d’intervention</h3>
          {zones.map((z) => (
            <a href={`/assistante-independante/${z.slug}`}>{z.nom}</a>
          ))}
        </div>
        <div class="index-groupe">
          <h3>Guides</h3>
          {guides.map((g) => (
            <a href={`/guides/${g.slug}`}>{g.nom}</a>
          ))}
        </div>
      </div>
    </nav>

    <div class="footer__bottom">
      <span>© {year} BrittAssist — Brittany Dreano</span>
      <span>SIRET 948 131 818 00023</span>
    </div>
  </div>
</footer>
