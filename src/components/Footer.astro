---
import SocialLinks from './SocialLinks.astro';
const year = new Date().getFullYear();
---

<footer role="contentinfo">
  <div class="container">
    <div class="footer-top footer-top--four">
      <div>
        <div class="footer-brand">
          <img src="/images/logo.png" alt="Logo Brittassist" width="40" height="40" loading="lazy" />
          <span class="footer-logo">Brittassist</span>
        </div>
        <p class="footer-tagline"><em>Assistance digitale humaine + IA</em></p>
        <p class="footer-desc">
          Brittany Dreano accompagne les entrepreneurs, artisans, commerçants
          et TPE pour gagner du temps et se concentrer sur l'essentiel.
        </p>
        <p style="font-size: 0.8rem; opacity: 0.6;">
          SIRET 948 131 818 00023 · Vendée (85)
        </p>
      </div>

      <div class="footer-section">
        <h3>Naviguer</h3>
        <ul class="footer-links">
          <li><a href="/">Accueil</a></li>
          <li><a href="/domaines-intervention">Domaines d'intervention</a></li>
          <li><a href="/methode">Méthode</a></li>
          <li><a href="/a-propos">À propos</a></li>
          <li><a href="/ecosysteme">Écosystème</a></li>
        </ul>
      </div>

      <div class="footer-section">
        <h3>Écosystème</h3>
        <ul class="footer-links">
          <li>
            <a href="https://www.axdia.fr" target="_blank" rel="noopener">
              Axdia, partenaire tech ↗
            </a>
          </li>
          <li><a href="/ecosysteme">Tous les partenaires</a></li>
          <li><a href="/assistante-administrative-vendee">Vendée &amp; local</a></li>
          <li><a href="/questionnaire">Questionnaire</a></li>
        </ul>
      </div>

      <div class="footer-section">
        <h3>Contact</h3>
        <ul class="footer-links">
          <li><a href="mailto:brittany@brittassist.fr">brittany@brittassist.fr</a></li>
          <li><a href="tel:+33667249727">06.67.24.97.27</a></li>
          <li>
            <a href="https://calendly.com/brittassist85/rendez-vous-decouverte" target="_blank" rel="noopener">
              Réserver un appel ↗
            </a>
          </li>
          <li>Du lundi au vendredi · Réponse sous 24 h</li>
        </ul>

        <h3 style="margin-top: 28px;">Suivez Brittassist</h3>
        <SocialLinks variant="footer" />
      </div>
    </div>

    <div class="footer-bottom">
      <span class="footer-copyright">
        © {year} Brittassist, Brittany Dreano. Tous droits réservés.
      </span>
      <div class="footer-legal">
        <a href="/mentions-legales">Mentions légales</a>
        <a href="/cgv">CGV</a>
        <a href="/politique-confidentialite">Confidentialité</a>
      </div>
    </div>
  </div>
</footer>
