---
import Monogram from './Monogram.astro';
import { metiersGeneres } from '../data/metiers-publies';
import { zones } from '../data/zones';
import { cheminDuGuide, dossiers, guidesGeneres, pilierDuDossier } from '../data/bibliotheque';
import { estGeneree } from '../data/publication.mjs';
const year = new Date().getFullYear();

// Colonne « Guides » : les dossiers dès qu'un pilier est publié, car une liste
// de cent liens répétée sur chaque page ne sert plus personne. Sinon, la liste
// d'origine des guides.
const piliers = dossiers
  .map((d) => ({ dossier: d, pilier: pilierDuDossier(d.slug) }))
  .filter((x) => x.pilier);
const guides = guidesGeneres();
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer__grid">
      <div>
        <div class="footer__brand">
          <Monogram variant="foot" />
          <span class="footer__name">BrittAssist</span>
        </div>
        <p class="footer__role">
          Executive &amp; Lifestyle Assistant.<br />
          Private Office externalisé.
        </p>
      </div>

      <nav aria-label="Liens de pied de page">
        <ul class="footer__links">
          <li><a href="/contact">Contact</a></li>
          <li><a href="/tarifs">Tarifs</a></li>
          <li>
            <a href="https://www.linkedin.com/in/brittassit85/" target="_blank" rel="noopener">
              LinkedIn
            </a>
          </li>
          <li>
            <a href="https://www.instagram.com/brittassist85" target="_blank" rel="noopener">
              Instagram
            </a>
          </li>
          {estGeneree('/methode-editoriale') && <li><a href="/methode-editoriale">Méthode éditoriale</a></li>}
          <li><a href="/mentions-legales">Mentions légales</a></li>
          <li><a href="/cgv">CGV</a></li>
          <li><a href="/politique-confidentialite">Politique de confidentialité</a></li>
        </ul>
      </nav>
    </div>

    <!-- Plan du site : maillage sitewide vers les trois familles de pages
         (métier, zone, guide). C'est le principal chemin de découverte. -->
    <nav class="footer__seo" aria-label="Plan du site">
      <div class="index-prestations">
        <div class="index-groupe">
          <h3>Par métier</h3>
          {metiersGeneres().map((m) => (
            <a href={`/assistante/${m.slug}`}>{m.nom}</a>
          ))}
          <a href="/assistante">Tous les métiers accompagnés</a>
        </div>
        <div class="index-groupe">
          <h3>Zones d’intervention</h3>
          {zones.map((z) => (
            <a href={`/assistante-independante/${z.slug}`}>{z.nom}</a>
          ))}
          <a href="/assistante-independante">Où intervient BrittAssist</a>
        </div>
        <div class="index-groupe">
          <h3>Guides</h3>
          {piliers.length > 0
            ? piliers.map(({ dossier, pilier }) => pilier && <a href={cheminDuGuide(pilier)}>{dossier.nom}</a>)
            : guides.map((g) => <a href={cheminDuGuide(g)}>{g.nom}</a>)}
          <a href="/guides">Tous les guides</a>
        </div>
      </div>
    </nav>

    <div class="footer__bottom">
      <span>© {year} BrittAssist — Brittany Dreano</span>
      <span>SIRET 948 131 818 00023</span>
    </div>
  </div>
</footer>
