---
import Monogram from './Monogram.astro';

const currentPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const links = [
  { href: '/private-office', label: 'Private Office' },
  { href: '/services', label: 'Services' },
  { href: '/tarifs', label: 'Tarifs' },
  { href: '/guides', label: 'Guides' },
  { href: '/articles', label: 'Articles' },
  { href: '/a-propos', label: 'À propos' },
];
const isActive = (href: string) => currentPath === href || currentPath.startsWith(href + '/');
---

<a href="#main-content" class="skip-link">Aller au contenu principal</a>
<nav id="navbar" aria-label="Navigation principale">
  <div class="nav-inner">
    <a href="/" class="nav-brand" aria-label="BrittAssist — Accueil">
      <Monogram variant="nav" />
      <span class="nav-brand__name">BrittAssist</span>
    </a>

    <ul class="nav-links" id="nav-links">
      {links.map((link) => (
        <li>
          <a href={link.href} class={isActive(link.href) ? 'active' : ''} aria-current={isActive(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))}
      <li class="nav-links__cta"><a href="/contact">Échanger avec Brittany →</a></li>
    </ul>

    <div class="nav-actions">
      <a href="/contact" class="nav-cta">Parler de mon organisation</a>
      <button class="nav-hamburger" id="nav-hamburger" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="nav-links"><span></span></button>
    </div>
  </div>
</nav>

<script>
  const hamburger = document.getElementById('nav-hamburger');
  const links = document.getElementById('nav-links');
  if (hamburger && links) {
    const close = () => {
      hamburger.setAttribute('aria-expanded', 'false');
      hamburger.setAttribute('aria-label', 'Ouvrir le menu');
      links.classList.remove('open');
      document.body.classList.remove('nav-open');
    };
    hamburger.addEventListener('click', () => {
      const open = hamburger.getAttribute('aria-expanded') === 'true';
      if (open) close();
      else {
        hamburger.setAttribute('aria-expanded', 'true');
        hamburger.setAttribute('aria-label', 'Fermer le menu');
        links.classList.add('open');
        document.body.classList.add('nav-open');
        // Les liens précèdent le bouton dans le document : sans cela, Tab partirait vers la page, sous le menu.
        links.querySelector('a')?.focus();
      }
    });
    links.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const ouvert = hamburger.getAttribute('aria-expanded') === 'true';
      close();
      if (ouvert) hamburger.focus();
    });
  }
</script>
