---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionMark from '../components/SectionMark.astro';
import Button from '../components/Button.astro';

const title = "Assistante administrative en Vendée, Brittassist · Humain + IA";
const description = "Assistante digitale en Vendée (La Roche-sur-Yon, Les Sables, Challans, Montaigu, Luçon). Délégation administrative, emails, organisation, réseaux sociaux et IA pratique. 100 % à distance.";
---

<BaseLayout title={title} description={description}>
  <header class="page-hero page-hero--yellow">
    <div class="container">
      <p class="hero-eyebrow">Vendée · 85</p>
      <h1>
        Assistante digitale en <em>Vendée</em>.<br />
        Humain &amp; IA, à votre service.
      </h1>
      <p class="lede">
        Basée en Vendée (La Roche-sur-Yon), j'accompagne les indépendants,
        artisans, commerçants et TPE locaux. Vous déléguez ce qui vous prend
        du temps, administratif, emails, réseaux, organisation, pendant que
        je m'appuie sur les bons outils (et l'IA) pour aller vite et bien.
      </p>
      <div style="display: flex; gap: 14px; flex-wrap: wrap;">
        <Button href="/contact" variant="primary">
          Réserver mon appel découverte <span class="btn-arrow">→</span>
        </Button>
        <Button href="/domaines-intervention" variant="outline-dark">
          Voir mes domaines
        </Button>
      </div>
    </div>
  </header>

  <section class="section-folio">
    <div class="container">
      <SectionMark num="01" label="Pour qui ?" />
      <div class="section-folio__head reveal">
        <h2 class="section-folio__title">
          Vous êtes un entrepreneur <em>local</em>&nbsp;?
        </h2>
        <p class="section-folio__lede">
          Brittassist s'adresse en priorité aux entrepreneurs vendéens
          artisans, commerçants, indépendants, TPE, qui veulent déléguer le
          quotidien sans recruter, ni se prendre la tête avec des outils
          compliqués.
        </p>
      </div>

      <div class="local-grid reveal d-1">
        <div class="local-card">
          <span class="local-icon">🔨</span>
          <h3>Artisans &amp; commerçants</h3>
          <p>Menuisiers, plombiers, coiffeurs, fleuristes, restaurateurs… Vous travaillez les mains dans le métier, je m'occupe du reste.</p>
        </div>
        <div class="local-card">
          <span class="local-icon">💼</span>
          <h3>Indépendants &amp; freelances</h3>
          <p>Consultants, coachs, formateurs, naturopathes… Vous facturez votre expertise, pas votre temps administratif.</p>
        </div>
        <div class="local-card">
          <span class="local-icon">🏢</span>
          <h3>TPE &amp; petites entreprises</h3>
          <p>Vous avez 2 à 20 personnes, pas encore de structure admin/communication interne. On comble le manque.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-folio bleed-rose">
    <div class="container">
      <SectionMark num="02" label="Zone d'intervention" />
      <div class="section-folio__head reveal">
        <h2 class="section-folio__title">
          Tout le département (et au-delà), <em>100 % à distance</em>.
        </h2>
        <p class="section-folio__lede">
          Basée à La Roche-sur-Yon, je travaille avec des entrepreneurs partout
          en Vendée et au-delà. Le 100 % à distance n'empêche pas la
          proximité : on échange en visio, par WhatsApp ou par email selon vos
          préférences.
        </p>
      </div>

      <div class="locations-tags reveal d-1">
        <span class="location-tag">La Roche-sur-Yon</span>
        <span class="location-tag">Les Sables-d'Olonne</span>
        <span class="location-tag">Challans</span>
        <span class="location-tag">Montaigu</span>
        <span class="location-tag">Fontenay-le-Comte</span>
        <span class="location-tag">Luçon</span>
        <span class="location-tag">Saint-Gilles-Croix-de-Vie</span>
        <span class="location-tag">Aizenay</span>
        <span class="location-tag">Toute la Vendée (85)</span>
        <span class="location-tag">Reste de la France</span>
      </div>
    </div>
  </section>

  <section class="section-folio">
    <div class="container">
      <SectionMark num="03" label="Ce que vous déléguez" />
      <div class="section-folio__head reveal">
        <h2 class="section-folio__title">
          Tout ce qui vous prend du temps, sans vous rapporter directement.
        </h2>
        <p class="section-folio__lede">
          Voici les tâches que vous pouvez me confier, seules ou combinées.
          Aucun pack figé : on construit ensemble ce qui vous correspond.
        </p>
      </div>

      <div class="domain-grid reveal d-1">
        <article class="domain-card">
          <div class="domain-card__icon">📋</div>
          <h3 class="domain-card__title">Administratif</h3>
          <p class="domain-card__desc">Devis, factures, suivi clients, relances, classement.</p>
        </article>
        <article class="domain-card">
          <div class="domain-card__icon">📧</div>
          <h3 class="domain-card__title">Emails</h3>
          <p class="domain-card__desc">Tri, réponses simples, règles, synthèse IA quotidienne.</p>
        </article>
        <article class="domain-card">
          <div class="domain-card__icon">🗓️</div>
          <h3 class="domain-card__title">Organisation</h3>
          <p class="domain-card__desc">Planning, suivi des tâches, reporting d'activité.</p>
        </article>
        <article class="domain-card">
          <div class="domain-card__icon">📱</div>
          <h3 class="domain-card__title">Réseaux sociaux</h3>
          <p class="domain-card__desc">Création de contenu (avec IA), publication, engagement.</p>
        </article>
        <article class="domain-card">
          <div class="domain-card__icon">🛠️</div>
          <h3 class="domain-card__title">Support digital</h3>
          <p class="domain-card__desc">Outils, modèles, formations express si besoin.</p>
        </article>
        <article class="domain-card">
          <div class="domain-card__icon">✨</div>
          <h3 class="domain-card__title">IA pratique</h3>
          <p class="domain-card__desc">ChatGPT, Claude, automatisations simples qui vous font gagner 1 h par jour.</p>
        </article>
      </div>

      <div style="text-align:center; margin-top: 48px;" class="reveal">
        <Button href="/domaines-intervention" variant="outline-dark">
          Détail de chaque domaine →
        </Button>
      </div>
    </div>
  </section>

  <section class="cta-final-folio">
    <div class="container container--narrow reveal">
      <h2>Un projet plus <em>technique</em>&nbsp;?</h2>
      <p>
        Refonte de site, audit, agent IA, automatisation avancée, CRM&nbsp;?
        Je m'appuie sur <strong>Axdia</strong>, mon partenaire technique, et un
        réseau de pros vendéens pour aller plus loin.
      </p>
      <Button href="/ecosysteme" variant="primary">
        Découvrir l'écosystème →
      </Button>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--rose-fonce);
    margin-bottom: 18px;
    font-weight: 500;
  }
  h1 em, h2 em, h3 em { font-style: italic; color: var(--rose-fonce); }

  .local-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  @media (max-width: 900px) { .local-grid { grid-template-columns: 1fr; } }
  .local-card {
    background: var(--blanc);
    border: 1px solid rgba(232, 160, 176, 0.2);
    border-radius: var(--radius-lg);
    padding: 32px 28px;
    transition: transform var(--transition), box-shadow var(--transition);
  }
  html.dark .local-card { background: var(--dm-surface); border-color: rgba(232, 160, 176, 0.14); }
  .local-card:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .local-icon { font-size: 2.2rem; display: block; margin-bottom: 14px; }
  .local-card h3 { font-size: 1.2rem; margin-bottom: 10px; }
  .local-card p { color: var(--gris-moyen); font-size: 0.95rem; line-height: 1.6; }

  .locations-tags { display: flex; flex-wrap: wrap; gap: 10px; }
  .location-tag {
    padding: 8px 16px;
    background: var(--blanc);
    border: 1px solid rgba(232, 160, 176, 0.3);
    border-radius: var(--radius-pill);
    font-size: 0.88rem;
    color: var(--anthracite);
  }
  html.dark .location-tag { background: var(--dm-surface); }
</style>
