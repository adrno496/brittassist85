---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';

// Page volontairement non indexée et absente de la navigation : elle est
// transmise par Brittany après un premier échange, pour préparer le
// périmètre. L'accueil ne doit jamais renvoyer vers un formulaire long.
const title = "Préparer votre Private Office · BrittAssist";
const description =
  "Formulaire de préparation transmis après un premier échange, pour définir le périmètre de votre Private Office.";

const domaines = [
  'Executive Admin — facturation, contrats, échéances',
  'Agenda & Coordination — rendez-vous, confirmations',
  'Travel — vols, trains, hôtels, transferts',
  'Lifestyle — restaurants, événements, cadeaux',
  'Private Coordination — prestataires, organisation personnelle',
  'International — échanges en anglais',
];
---

<BaseLayout title={title} description={description} noindex={true}>
  <header class="hero hero--page">
    <div class="container">
      <p class="eyebrow">Préparation</p>
      <h1 class="hero__title">Quelques éléments avant de définir le périmètre.</h1>
      <p class="hero__sub">
        Ce formulaire n’est pas un préalable à notre échange : il le prolonge.
        Répondez à ce que vous pouvez, laissez le reste — nous compléterons
        ensemble.
      </p>
    </div>
  </header>

  <section class="band band--noir-doux">
    <div class="container container--narrow">
      <div id="form-sent" class="form-sent" hidden>
        <strong>Bien reçu.</strong> Je reviens vers vous avec une première
        lecture du périmètre.
      </div>

      <form
        class="form reveal"
        data-axdia-form
        data-subject="Préparation du périmètre (questionnaire)"
        action="https://formsubmit.co/brittanydreano.cm%40gmail.com"
        method="POST"
      >
        <input type="hidden" name="_subject" value="Préparation Private Office — BrittAssist" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_next" value="https://www.brittassist.fr/questionnaire?sent=true" />

        <fieldset>
          <legend>Vous</legend>
          <div class="form-row">
            <div class="form-group">
              <label for="firstname">Prénom <span class="required">*</span></label>
              <input type="text" id="firstname" name="prenom" required autocomplete="given-name" />
            </div>
            <div class="form-group">
              <label for="lastname">Nom <span class="required">*</span></label>
              <input type="text" id="lastname" name="nom" required autocomplete="family-name" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="email">E-mail <span class="required">*</span></label>
              <input type="email" id="email" name="email" required autocomplete="email" />
            </div>
            <div class="form-group">
              <label for="phone">Téléphone <span class="optional">(facultatif)</span></label>
              <input type="tel" id="phone" name="telephone" autocomplete="tel" />
            </div>
          </div>
        </fieldset>

        <fieldset>
          <legend>Votre activité</legend>
          <div class="form-group">
            <label for="profil">Votre rôle <span class="required">*</span></label>
            <select id="profil" name="profil" required>
              <option value="">Sélectionnez…</option>
              <option>Dirigeant d’entreprise</option>
              <option>Entrepreneur indépendant</option>
              <option>Profession libérale</option>
              <option>Investisseur</option>
              <option>Autre</option>
            </select>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="metier">Secteur d’activité</label>
              <input type="text" id="metier" name="metier" autocomplete="organization" />
            </div>
            <div class="form-group">
              <label for="taille">Taille de la structure</label>
              <select id="taille" name="taille">
                <option value="">Sélectionnez…</option>
                <option>Seul</option>
                <option>2 à 10 personnes</option>
                <option>11 à 50 personnes</option>
                <option>Plus de 50 personnes</option>
                <option>Plusieurs entités</option>
              </select>
            </div>
          </div>
        </fieldset>

        <fieldset>
          <legend>Ce que vous portez encore</legend>
          <div class="form-group">
            <label id="domaines-label">
              Les univers sur lesquels vous aimeriez être déchargé
              <span class="optional">(plusieurs réponses possibles)</span>
            </label>
            <div class="check-grid" role="group" aria-labelledby="domaines-label">
              {domaines.map((d) => (
                <label class="check-item">
                  <input type="checkbox" name="domaines[]" value={d} />
                  <span>{d}</span>
                </label>
              ))}
            </div>
          </div>
        </fieldset>

        <fieldset>
          <legend>Le contexte</legend>
          <div class="form-group">
            <label for="contexte">Comment se passe une semaine, en ce moment ?</label>
            <textarea id="contexte" name="contexte" rows="5"></textarea>
          </div>
          <div class="form-group">
            <label for="objectif">Qu’aimeriez-vous ne plus avoir à faire dans trois mois ?</label>
            <textarea id="objectif" name="objectif" rows="5"></textarea>
          </div>
        </fieldset>

        <fieldset>
          <legend>Le cadre</legend>
          <div class="form-row">
            <div class="form-group">
              <label for="timing">À partir de quand ?</label>
              <select id="timing" name="timing">
                <option value="">Sélectionnez…</option>
                <option>Dès que possible</option>
                <option>Dans le mois</option>
                <option>Dans les trois mois</option>
                <option>J’explore</option>
              </select>
            </div>
            <div class="form-group">
              <label for="budget">Format envisagé</label>
              <select id="budget" name="budget">
                <option value="">Sélectionnez…</option>
                <option>Executive Private Office</option>
                <option>Private Office sur mesure</option>
                <option>Mission ponctuelle</option>
                <option>À définir ensemble</option>
              </select>
            </div>
          </div>
        </fieldset>

        <div class="form-check">
          <input type="checkbox" id="rgpd" name="rgpd" required />
          <label for="rgpd">
            <span>
              Je consens au traitement de mes données dans le seul but de
              préparer notre échange.
              <a href="/politique-confidentialite">Politique de confidentialité</a>.
            </span>
          </label>
        </div>

        <Button type="submit" variant="ivoire">Envoyer</Button>
        <p class="form-note">
          Vos réponses restent confidentielles et ne sont transmises à aucun
          tiers commercial.
        </p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  if (new URLSearchParams(window.location.search).get('sent') === 'true') {
    const el = document.getElementById('form-sent');
    if (el) {
      el.hidden = false;
      el.scrollIntoView({ block: 'center' });
    }
  }
</script>
