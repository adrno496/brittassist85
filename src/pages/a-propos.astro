---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Monogram from '../components/Monogram.astro';

const title = "Brittany Dreano, executive & lifestyle assistant · BrittAssist";
const description =
  "Brittany Dreano, fondatrice de BrittAssist : sept ans d’assistance en entreprise, puis un Private Office externalisé pour dirigeants. Parcours et standards.";

const standards = [
  {
    num: 'Un interlocuteur',
    desc: 'Vous parlez toujours à la même personne. Vos préférences ne se réexpliquent pas.',
  },
  {
    num: 'Le suivi',
    desc: 'Une demande a toujours un statut. Aucune ne se perd entre un mardi et un jeudi.',
  },
  {
    num: 'La discrétion',
    desc: 'Contrats, montants, agendas, vie privée : ce qui passe par moi n’en sort pas.',
  },
  {
    num: 'L’anticipation',
    desc: 'L’information qui manque est demandée avant que le sujet bloque, pas après.',
  },
];
---

<BaseLayout title={title} description={description}>
  <header class="hero hero--page">
    <div class="container">
      <p class="eyebrow">À propos</p>
      <h1 class="hero__title">La personne derrière votre Private Office.</h1>
      <p class="hero__sub">
        Je m’appelle Brittany Dreano. J’accompagne des entrepreneurs et des
        dirigeants dans l’organisation de leur quotidien professionnel et
        personnel.
      </p>
    </div>
  </header>

  <!-- ── Portrait + parcours ──────────────────────────────── -->
  <section class="band band--noir-doux">
    <div class="container">
      <div class="person">
        <div class="person__media media--parcours reveal">
          <picture>
            <source
              type="image/webp"
              srcset="/images/portrait-brittany-parcours-640.webp 640w, /images/portrait-brittany-parcours-1000.webp 1000w"
              sizes="(max-width: 900px) 92vw, 480px"
            />
            <img
              src="/images/portrait-brittany-parcours.jpg"
              alt="Brittany Dreano, fondatrice de BrittAssist"
              width="1000"
              height="1250"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </picture>
        </div>

        <div class="person__text reveal d-1">
          <p class="eyebrow">Parcours</p>
          <h2>Sept ans à voir de près ce qui encombre un dirigeant.</h2>
          <p class="lede u-mt-24">
            J’ai exercé le métier d’assistante en entreprise pendant sept ans.
            Sept ans à observer la même mécanique : des dirigeants compétents,
            occupés à des dizaines de micro-arbitrages qui n’avaient aucune
            raison de leur revenir.
          </p>
          <p class="lede u-mt-24">
            Je suis devenue indépendante pour faire ce travail autrement :
            m’investir vraiment dans le quotidien de quelques personnes, plutôt
            que d’exécuter des tâches pour beaucoup. C’est de là que vient le
            format Private Office — un seul interlocuteur, un périmètre large,
            et un engagement sur le résultat plutôt que sur le geste.
          </p>

          <blockquote class="person__quote">
            Mon travail n’est pas de devenir une personne supplémentaire à
            manager. Mon travail est précisément de vous enlever des sujets à
            manager.
          </blockquote>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Standards de service ─────────────────────────────── -->
  <section class="band band--ivoire">
    <div class="container">
      <div class="band__head band__head--wide reveal">
        <p class="eyebrow">Standards de service</p>
        <h2>Quatre choses sur lesquelles je ne transige pas.</h2>
      </div>

      <div class="steps">
        {standards.map((s, i) => (
          <div class={`step reveal d-${i}`}>
            <span class="step__num">{s.num}</span>
            <p class="step__desc">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Comment je travaille ─────────────────────────────── -->
  <section class="band band--noir">
    <div class="container">
      <div class="duo reveal">
        <div>
          <p class="eyebrow">Manière de faire</p>
          <h2>Traverser plusieurs univers dans la même journée.</h2>
        </div>
        <div>
          <p class="lede u-mb-24">
            Un contrat le matin, un déplacement à recomposer à midi, un
            prestataire à relancer l’après-midi, une table à réserver le soir.
            La difficulté du métier n’est pas la complexité d’une tâche prise
            isolément : c’est de tenir tous les fils en même temps sans qu’un
            seul ne tombe.
          </p>
          <ul class="list-plain">
            <li>Une mémoire tenue de vos préférences, de vos échéances et de vos interlocuteurs.</li>
            <li>Un anglais courant pour les contacts et les réservations à l’étranger.</li>
            <li>L’habitude des sujets sensibles, professionnels comme personnels.</li>
            <li>Une obsession du suivi : rien n’est fini tant que ce n’est pas confirmé.</li>
          </ul>
        </div>
      </div>

      <hr class="rule reveal" />

      <p class="closing closing--wide reveal">
        Vous gardez les décisions. J’absorbe le reste.
      </p>
    </div>
  </section>

  <!-- ── Cadre ────────────────────────────────────────────── -->
  <section class="band band--rose band--tight">
    <div class="container">
      <div class="duo reveal">
        <div>
          <p class="eyebrow">Le cadre</p>
          <h2>Basée en Vendée, disponible partout.</h2>
        </div>
        <div>
          <p class="lede">
            BrittAssist est une micro-entreprise immatriculée en Vendée
            (SIRET 948 131 818 00023). L’accompagnement se conduit à distance,
            quel que soit l’endroit où vous vous trouvez, et s’étend à vos
            interlocuteurs étrangers lorsque c’est nécessaire.
          </p>
          <div class="btn-row u-mt-40">
            <Button href="/private-office" variant="noir">Comment ça fonctionne</Button>
            <Button href="/services" variant="lien">Voir les six univers</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-final">
    <Monogram variant="ghost" />
    <div class="container container--narrow reveal">
      <h2>Le mieux, pour faire connaissance, reste trente minutes d’échange.</h2>
      <p class="lede">
        Vous décrivez votre organisation actuelle. Je vous dis ce qu’un Private
        Office pourrait en absorber.
      </p>
      <div class="cta-final__actions">
        <Button href="/contact" variant="ivoire">Échanger avec Brittany</Button>
      </div>
      <p class="cta-final__fine">
        Accompagnement à partir de 700 € / mois &nbsp;•&nbsp; Sur mesure
        &nbsp;•&nbsp; Confidentiel
      </p>
    </div>
  </section>
</BaseLayout>
