---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import WorkDemo from '../components/WorkDemo.astro';

const title = "Assistante de direction externalisée pour dirigeants · BrittAssist";
const description = "Brittany Dreano accompagne les dirigeants à distance, depuis La Roche-sur-Yon : administratif, agenda, déplacements, coordination. Private Office dès 700 € / mois.";

const services = [
  { num: '01', name: 'Executive Admin', desc: 'Facturation, contrats, échéances, documents et suivi administratif.', href: '/services/gestion-administrative' },
  { num: '02', name: 'Agenda & Coordination', desc: 'Rendez-vous, arbitrages d’horaires, confirmations et coordination des interlocuteurs.', href: '/services/coordination' },
  { num: '03', name: 'Travel', desc: 'Vols, trains, hôtels, transferts, itinéraires et modifications en cours de route.', href: '/services/organisation-deplacements' },
  { num: '04', name: 'Lifestyle', desc: 'Restaurants, événements, cadeaux, billetterie et recherches sur mesure.', href: '/services/reservations' },
  { num: '05', name: 'Private Coordination', desc: 'Prestataires, interventions, organisation personnelle et sujets du quotidien.', href: '/services/organisation-personnelle' },
  { num: '06', name: 'International', desc: 'Échanges en anglais et coordination avec des interlocuteurs étrangers.', href: '/services/assistanat-anglais' },
];

const method = [
  { name: 'Vous envoyez la demande', desc: 'WhatsApp, e-mail ou le canal convenu. Une phrase suffit lorsque le contexte est déjà connu.' },
  { name: 'Je clarifie le strict nécessaire', desc: 'Je ne vous renvoie pas un questionnaire : seulement les informations qui empêchent réellement d’avancer.' },
  { name: 'Je prends en charge', desc: 'Recherche, coordination, relance, réservation, suivi : le sujet avance sans rester dans votre tête.' },
  { name: 'Je ferme la boucle', desc: 'Vous recevez un résultat, un statut clair, ou la seule décision qui nécessite vraiment votre arbitrage.' },
];
---

<BaseLayout title={title} description={description}>
  <header class="ba-home-hero">
    <div class="container ba-home-hero__grid">
      <div class="ba-home-hero__copy">
        <p class="ba-home-hero__meta">Private Office externalisé · La Roche-sur-Yon</p>
        <h1>Vous gardez les décisions. <em>J’absorbe le reste.</em></h1>
        <p class="ba-home-hero__lead">Je suis Brittany Dreano. J’accompagne à distance les entrepreneurs et dirigeants dans ce qui leur vole du temps sans exiger leur expertise : administratif, agenda, déplacements, réservations et coordination.</p>
        <div class="ba-home-hero__actions">
          <Button href="/contact" variant="noir">Parler de mon organisation</Button>
          <Button href="/private-office" variant="lien">Découvrir le Private Office</Button>
        </div>
        <p class="ba-home-hero__price"><strong>À partir de 700 € / mois</strong><span>•</span><span>Accompagnement sur mesure</span></p>
      </div>

      <div class="ba-home-hero__visual" aria-label="Brittany Dreano au travail">
        <div class="ba-home-hero__photo">
          <picture>
            <source type="image/webp" srcset="/images/brittany-pro-1-800.webp 800w, /images/brittany-pro-1-1400.webp 1400w" sizes="(max-width: 720px) 175vw, 800px" />
            <img src="/images/brittany-pro-1.jpg" alt="Brittany Dreano travaillant sur son ordinateur" width="1600" height="1067" loading="eager" fetchpriority="high" decoding="async" />
          </picture>
        </div>
        <div class="ba-home-hero__card">
          <span class="ba-home-hero__card-label">Le principe</span>
          <strong>Une demande. Une personne responsable. Une boucle fermée.</strong>
          <p>Pas une boîte à outils de plus. Une personne qui tient les fils jusqu’au résultat.</p>
        </div>
      </div>
    </div>
  </header>

  <div class="ba-scope-strip" aria-label="Repères BrittAssist">
    <div class="container ba-scope-strip__inner">
      <div class="ba-scope-strip__item">Un seul point d’entrée pour votre quotidien.</div>
      <div class="ba-scope-strip__item"><span>Base</span>La Roche-sur-Yon · Vendée</div>
      <div class="ba-scope-strip__item"><span>Suivi</span>À distance · France & international</div>
      <div class="ba-scope-strip__item"><span>Langues</span>Français · Anglais</div>
      <div class="ba-scope-strip__item"><span>Format</span>Récurrent ou ponctuel</div>
    </div>
  </div>

  <section class="band ba-intro">
    <div class="container ba-intro__grid">
      <div class="ba-intro__sticky reveal">
        <p class="eyebrow">Le vrai problème</p>
        <h2>Ce n’est pas la tâche. C’est tout ce qu’elle vous oblige à garder en tête.</h2>
      </div>
      <div class="ba-intro__body reveal d-1">
        <p class="ba-intro__big">Un train à changer, une facture à retrouver, trois personnes à recaler, un prestataire à relancer. Chaque sujet est petit. Ensemble, ils découpent votre journée.</p>
        <p>BrittAssist fonctionne comme un Private Office externalisé : vous transmettez le résultat attendu, je reprends le contexte, j’avance et je vous sollicite uniquement lorsque votre décision est indispensable.</p>
        <div class="ba-intro__facts">
          <div class="ba-intro__fact"><strong>7 ans</strong><span>d’assistance en entreprise avant l’indépendance</span></div>
          <div class="ba-intro__fact"><strong>6 univers</strong><span>professionnels et personnels dans un même accompagnement</span></div>
          <div class="ba-intro__fact"><strong>1 point d’entrée</strong><span>pour éviter de multiplier les prestataires et les outils</span></div>
        </div>
      </div>
    </div>
  </section>

  <WorkDemo />

  <section class="band ba-services">
    <div class="container">
      <div class="ba-services__head reveal">
        <div><p class="eyebrow">Périmètre</p><h2>Six univers. Un même réflexe : je m’en occupe.</h2></div>
        <p>Le quotidien d’un dirigeant ne se découpe pas proprement entre “administratif”, “voyage” et “personnel”. L’accompagnement non plus. Les univers servent à comprendre le périmètre, pas à vous enfermer dans un catalogue.</p>
      </div>
      <div class="ba-services__list reveal">
        {services.map((service) => (
          <a href={service.href} class="ba-service-row">
            <span class="ba-service-row__num">{service.num}</span>
            <strong class="ba-service-row__name">{service.name}</strong>
            <span class="ba-service-row__desc">{service.desc}</span>
            <span class="ba-service-row__arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
      <div class="u-mt-40 reveal"><Button href="/services" variant="ivoire">Voir tout le périmètre</Button></div>
    </div>
  </section>

  <section class="band ba-method">
    <div class="container ba-method__grid">
      <div class="ba-method__head reveal">
        <p class="eyebrow">La méthode</p>
        <h2>Le minimum de friction entre votre demande et son résultat.</h2>
        <p>Le but n’est pas de vous faire mieux déléguer. Le but est que la délégation elle-même vous prenne le moins de temps possible.</p>
      </div>
      <div class="ba-method__steps reveal d-1">
        {method.map((step) => <article class="ba-method-step"><div><h3>{step.name}</h3><p>{step.desc}</p></div></article>)}
      </div>
    </div>
  </section>

  <section class="band ba-offers" id="accompagnement">
    <div class="container">
      <div class="ba-offers__head reveal">
        <div><p class="eyebrow">Accompagnement</p><h2>Trois façons de travailler ensemble.</h2></div>
        <p>Le bon format dépend du volume, de la fréquence et du niveau de continuité dont vous avez besoin. Le périmètre est défini avant de commencer.</p>
      </div>
      <div class="ba-offers__grid">
        <article class="ba-offer-card ba-offer-card--lead reveal">
          <span class="ba-offer-card__tag">Accompagnement principal</span>
          <h3>Executive Private Office</h3>
          <p class="ba-offer-card__price">700 € / mois</p>
          <p class="ba-offer-card__desc">Pour le dirigeant qui veut déléguer durablement plusieurs catégories de demandes et ne plus être le point de passage de chaque micro-sujet.</p>
          <div class="ba-offer-card__foot"><Button href="/contact" variant="ivoire">Échanger sur mon organisation</Button></div>
        </article>
        <article class="ba-offer-card reveal d-1">
          <span class="ba-offer-card__tag">Besoins étendus</span>
          <h3>Private Office sur mesure</h3>
          <p class="ba-offer-card__price">Sur devis</p>
          <p class="ba-offer-card__desc">Disponibilité renforcée, plusieurs structures, déplacements fréquents, coordination quotidienne ou besoins spécifiques.</p>
          <div class="ba-offer-card__foot"><Button href="/contact" variant="contour">Construire le périmètre</Button></div>
        </article>
        <article class="ba-offer-card reveal d-2">
          <span class="ba-offer-card__tag">Sans récurrence</span>
          <h3>Mission ponctuelle</h3>
          <p class="ba-offer-card__price">Sur devis</p>
          <p class="ba-offer-card__desc">Voyage, événement, recherche ou organisation spécifique qui doit être prise en charge de bout en bout.</p>
          <div class="ba-offer-card__foot"><Button href="/contact" variant="contour">Décrire ma mission</Button></div>
        </article>
      </div>
      <div class="u-mt-40 reveal"><Button href="/tarifs" variant="lien">Comprendre les tarifs et le devis</Button></div>
    </div>
  </section>

  <section class="band ba-about">
    <div class="container ba-about__grid">
      <div class="ba-about__photo reveal">
        <picture>
          <source type="image/webp" srcset="/images/portrait-brittany-parcours-640.webp 640w, /images/portrait-brittany-parcours-1000.webp 1000w" sizes="(max-width: 980px) 92vw, 460px" />
          <img src="/images/portrait-brittany-parcours.jpg" alt="Brittany Dreano, fondatrice de BrittAssist" width="900" height="1125" loading="lazy" decoding="async" />
        </picture>
      </div>
      <div class="ba-about__copy reveal d-1">
        <p class="eyebrow">La personne derrière BrittAssist</p>
        <h2>Un Private Office reste d’abord une relation de confiance.</h2>
        <p>Avant BrittAssist, Brittany a travaillé sept ans dans l’assistance en entreprise. Le métier lui a appris à passer d’un contrat à un déplacement, puis à un prestataire ou un agenda sans perdre le fil — et surtout à savoir ce qui doit revenir au dirigeant et ce qui ne devrait jamais lui revenir.</p>
        <blockquote class="ba-about__quote">« Mon travail n’est pas de devenir une personne supplémentaire à manager. Mon travail est de vous enlever des sujets à manager. »</blockquote>
        <Button href="/a-propos" variant="lien">Découvrir le parcours de Brittany</Button>
      </div>
    </div>
  </section>

  <section class="ba-final">
    <div class="container ba-final__inner">
      <div class="reveal"><p class="eyebrow">Le prochain sujet peut être le premier</p><h2>Qu’est-ce que vous ne devriez plus gérer vous-même ?</h2></div>
      <div class="ba-final__aside reveal d-1">
        <p>Décrivez votre organisation actuelle, vos demandes récurrentes ou simplement le sujet qui vous prend du temps aujourd’hui. L’échange sert à voir ce qui peut réellement être absorbé et sous quelles limites.</p>
        <div class="btn-row"><Button href="/contact" variant="ivoire">Échanger avec Brittany</Button><Button href="/questionnaire" variant="lien">Préparer mon besoin</Button></div>
        <p class="ba-final__fine">À partir de 700 € / mois · Sur mesure · Confidentiel</p>
      </div>
    </div>
  </section>
</BaseLayout>
