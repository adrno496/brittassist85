---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Monogram from '../components/Monogram.astro';
import { cheminDuGuide, dossiers, guidesGeneres, pagesDuDossier, pilierDuDossier } from '../data/bibliotheque';
import { metiersGeneres } from '../data/metiers-publies';
import { zones } from '../data/zones';
import { estGeneree } from '../data/publication.mjs';
import { SITE_URL, filDAriane, jsonLd } from '../lib/seo';

// Hub des guides : point d'entrée unique pour les requêtes informationnelles,
// et page qui distribue le maillage vers les trois familles de contenus.
const title = 'Guides : comprendre, comparer, décider · BrittAssist';
const description =
  "Coût d’une assistante, salariée ou indépendante, assistante virtuelle ou Private Office, comment déléguer : les réponses de fond, sans argumentaire.";

const guides = guidesGeneres();

// Présentation par dossier dès qu'un dossier autre que le premier a une page publiée,
// ou qu'un pilier existe. Sinon, on garde le classement d'origine par rubrique.
const parDossier = dossiers
  .map((d) => ({ dossier: d, pilier: pilierDuDossier(d.slug), pages: pagesDuDossier(d.slug) }))
  .filter((x) => x.pilier || x.pages.length > 0);
const presentationParDossier = parDossier.length > 1 || parDossier.some((x) => x.pilier);

const rubriques: string[] = [];
for (const g of guides) if (!rubriques.includes(g.categorie)) rubriques.push(g.categorie);
const parRubrique = rubriques.map((c) => ({ categorie: c, items: guides.filter((g) => g.categorie === c) }));

const url = `${SITE_URL}/guides`;
const donnees = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${url}#page`,
      url,
      name: title,
      description,
      inLanguage: 'fr-FR',
      isPartOf: { '@id': `${SITE_URL}/#website` },
    },
    {
      '@type': 'ItemList',
      '@id': `${url}#liste`,
      name: 'Guides BrittAssist',
      itemListElement: guides.map((g, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: g.nom,
        url: `${SITE_URL}${cheminDuGuide(g)}`,
      })),
    },
    filDAriane(url, [{ nom: 'Guides', href: '/guides' }]),
  ],
};
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" slot="head" set:html={jsonLd(donnees)} />

  <header class="hero hero--page">
    <div class="container">
      <p class="eyebrow">Guides</p>
      <h1 class="hero__title">Comprendre, comparer, décider.</h1>
      <p class="hero__sub">
        Ces pages ne vendent rien. Elles répondent aux questions qu’on se pose
        avant de déléguer : ce que ça coûte, ce que ça remplace, ce que ça ne
        remplace pas, et par quoi commencer. Y compris quand la réponse est que
        ce n’est pas pour vous.
      </p>
    </div>
  </header>

  <section class="band band--noir">
    <div class="container">
      {presentationParDossier ? (
        <div class="suite">
          {parDossier.map(({ dossier, pilier, pages }) => (
            <article class="suite__item reveal" id={dossier.slug}>
              <div>
                <h2 class="suite__name">{dossier.nom}</h2>
                <p class="suite__resume">{dossier.resume}</p>
                {pilier && (
                  <Button href={cheminDuGuide(pilier)} variant="lien">Ouvrir le dossier</Button>
                )}
              </div>
              <div>
                <div class="universes">
                  {pages.map((g) => (
                    <a class="universe universe--lien" href={cheminDuGuide(g)}>
                      <p class="universe__name">{g.nom}</p>
                      <p class="universe__desc">{g.description}</p>
                    </a>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="suite">
          {parRubrique.map((gr) => (
            <article class="suite__item reveal">
              <div>
                <h2 class="suite__name">{gr.categorie}</h2>
              </div>
              <div>
                <div class="universes">
                  {gr.items.map((g) => (
                    <a class="universe universe--lien" href={cheminDuGuide(g)}>
                      <p class="universe__name">{g.nom}</p>
                      <p class="universe__desc">{g.lede}</p>
                    </a>
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- ── Maillage vers les deux autres familles ───────────── -->
  <section class="band band--ivoire">
    <div class="container">
      <div class="band__head band__head--wide reveal">
        <p class="eyebrow">Aller plus loin</p>
        <h2>Le reste du site, par entrée.</h2>
        <p class="lede">
          Les guides répondent aux questions générales. Ces pages-là répondent à
          la vôtre : selon votre métier, votre territoire, ou la ligne précise du
          périmètre qui vous encombre.
        </p>
      </div>

      <div class="index-prestations reveal">
        <div class="index-groupe">
          <h3>Par métier</h3>
          {metiersGeneres().map((m) => (
            <a href={`/assistante/${m.slug}`}>{m.nom}</a>
          ))}
          <a href="/assistante">Tous les métiers accompagnés</a>
        </div>
        <div class="index-groupe">
          <h3>Par zone</h3>
          {zones.map((z) => (
            <a href={`/assistante-independante/${z.slug}`}>{z.nom}</a>
          ))}
          <a href="/assistante-independante">Où intervient BrittAssist</a>
        </div>
        <div class="index-groupe">
          <h3>Par besoin</h3>
          <a href="/services">Les six univers de prise en charge</a>
          <a href="/private-office">Le fonctionnement, étape par étape</a>
          <a href="/a-propos">Qui est Brittany Dreano</a>
          {estGeneree('/methode-editoriale') && <a href="/methode-editoriale">Comment ces guides sont écrits</a>}
          <a href="/contact">Échanger sur votre organisation</a>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-final">
    <Monogram variant="ghost" />
    <div class="container container--narrow reveal">
      <h2>Il reste toujours une question que la page ne traite pas.</h2>
      <p class="lede">
        C’est en général celle qui compte. Trente minutes, sans engagement,
        suffisent à y répondre sur votre situation précise.
      </p>
      <div class="cta-final__actions">
        <Button href="/contact" variant="ivoire">Échanger avec Brittany</Button>
      </div>
      <p class="cta-final__fine">
        Accompagnement à partir de 590 € / mois &nbsp;•&nbsp; Sur mesure
        &nbsp;•&nbsp; Confidentiel
      </p>
    </div>
  </section>
</BaseLayout>
