---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionMark from '../components/SectionMark.astro';
import Button from '../components/Button.astro';

const title = "Ma méthode en 4 temps — Brittassist";
const description = "Un parcours simple et transparent : découverte, analyse, proposition personnalisée, accompagnement flexible. Aucun engagement long, ajustable à tout moment.";

const steps = [
  {
    when: 'Étape 1',
    roman: 'i.',
    title: 'Découverte',
    desc: "Vous me racontez votre activité, vos blocages, ce qui vous prend du temps inutilement. Je pose les bonnes questions pour comprendre votre quotidien réel — pas juste votre liste de besoins.",
    deliver: 'Appel 30 min · Gratuit',
    expand: [
      "Format : appel téléphonique ou visio 30 minutes",
      "Ou via le questionnaire en ligne, si vous préférez l'écrit",
      "Sans engagement, ni carte bancaire",
    ],
  },
  {
    when: 'Étape 2',
    roman: 'ii.',
    title: 'Analyse',
    desc: "Je décortique ce qu'on s'est dit. J'identifie les tâches à déléguer en priorité, les petits outils à mettre en place, là où l'IA peut vous faire gagner du temps sans complexité.",
    deliver: 'Synthèse écrite',
    expand: [
      "Une note de synthèse claire et personnalisée",
      "Les 3-5 leviers les plus impactants pour vous",
      "Une vision réaliste : ce qui peut se faire vite, ce qui demande plus",
    ],
  },
  {
    when: 'Étape 3',
    roman: 'iii.',
    title: 'Proposition personnalisée',
    desc: "Devis sur mesure adapté à votre activité, votre charge de travail et votre budget. Aucun pack figé. On peut commencer petit et augmenter, ou l'inverse.",
    deliver: 'Devis sur mesure',
    expand: [
      "Mensuel ou ponctuel, à vous de choisir",
      "Volume d'heures ajustable",
      "Sans engagement de durée minimum (préavis 1 mois)",
    ],
  },
  {
    when: 'Étape 4',
    roman: 'iv.',
    title: 'Accompagnement flexible',
    desc: "On démarre. On ajuste à mesure que votre activité bouge — saisons hautes, projets ponctuels, périodes calmes. Je m'adapte à votre rythme et reste joignable.",
    deliver: 'Suivi régulier',
    expand: [
      "Communication par email, WhatsApp ou Notion (à votre préférence)",
      "Point mensuel pour ajuster ce qui doit l'être",
      "Vous arrêtez quand vous voulez avec 1 mois de préavis",
    ],
  },
];
---

<BaseLayout title={title} description={description}>
  <header class="page-hero">
    <div class="container">
      <p class="hero-eyebrow">Ma méthode</p>
      <h1>
        Une méthode en <em>quatre temps</em>, <br />
        sans surprises.
      </h1>
      <p class="lede">
        Avant d'arriver à un accompagnement qui vous correspond, on prend le
        temps de comprendre votre activité, vos contraintes et vos envies. Voici
        le chemin, étape par étape.
      </p>
    </div>
  </header>

  <section class="section-folio">
    <div class="container">
      <SectionMark num="01" label="Le parcours" />
      <div class="timeline reveal">
        {steps.map((s) => (
          <div class="timeline__step">
            <div class="timeline__when">{s.when}</div>
            <div class="timeline__roman">{s.roman}</div>
            <h2 class="timeline__title">{s.title}</h2>
            <p class="timeline__desc">{s.desc}</p>
            <span class="timeline__deliver">{s.deliver}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-folio bleed-rose">
    <div class="container">
      <SectionMark num="02" label="Le détail de chaque étape" />
      <div class="method-detail reveal">
        {steps.map((s) => (
          <div class="method-detail__step">
            <div class="method-detail__roman">{s.roman}</div>
            <div class="method-detail__body">
              <h3>{s.title}</h3>
              <p class="lede">{s.desc}</p>
              <ul>
                {s.expand.map((e) => <li>{e}</li>)}
              </ul>
              <span class="timeline__deliver">{s.deliver}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-folio">
    <div class="container container--narrow">
      <SectionMark num="03" label="Quelques questions courantes" />
      <div class="faq-accordion reveal">
        <details class="faq-item">
          <summary>
            <span class="faq-question">Combien de temps entre l'appel et le démarrage&nbsp;?</span>
          </summary>
          <p>
            En général, on peut démarrer sous 7 à 10 jours après l'appel
            découverte — le temps de signer le devis et de poser les premiers
            outils. Pour les besoins urgents, on peut aller plus vite si je suis
            disponible.
          </p>
        </details>
        <details class="faq-item">
          <summary>
            <span class="faq-question">Et si mes besoins évoluent en cours de route&nbsp;?</span>
          </summary>
          <p>
            C'est même prévu. Tous les mois, on fait un point ensemble pour
            ajuster le volume, ajouter ou retirer des tâches. Votre saison haute
            vous pousse à déléguer plus&nbsp;? On augmente. Période calme&nbsp;? On
            réduit.
          </p>
        </details>
        <details class="faq-item">
          <summary>
            <span class="faq-question">Comment on communique au quotidien&nbsp;?</span>
          </summary>
          <p>
            Selon ce qui vous va le mieux : email, WhatsApp, Slack ou Notion.
            Je m'adapte à votre outil principal. Je suis joignable du lundi au
            vendredi et je réponds toujours sous 24&nbsp;h.
          </p>
        </details>
        <details class="faq-item">
          <summary>
            <span class="faq-question">Puis-je arrêter quand je veux&nbsp;?</span>
          </summary>
          <p>
            Oui. Un mois de préavis et c'est tout — pour que je puisse boucler
            proprement ce qui était en cours. Pas d'engagement de durée
            minimum.
          </p>
        </details>
        <details class="faq-item">
          <summary>
            <span class="faq-question">Et si j'ai besoin de quelque chose de plus technique&nbsp;?</span>
          </summary>
          <p>
            Audit de site, agent IA conversationnel, automatisations avancées,
            CRM, refonte web&nbsp;? Je vous oriente vers <strong>Axdia</strong>
            (mon partenaire technique) ou un autre partenaire de confiance, et je
            reste impliquée pour faire le pont. Plus d'infos sur la page <a href="/ecosysteme">Écosystème</a>.
          </p>
        </details>
      </div>
    </div>
  </section>

  <section class="cta-final-folio">
    <div class="container container--narrow reveal">
      <h2>Première étape : <em>l'appel découverte</em>.</h2>
      <p>30 minutes, gratuit, sans engagement. On y voit déjà beaucoup plus clair.</p>
      <Button href="/contact" variant="primary">
        Réserver mon appel découverte <span class="btn-arrow">→</span>
      </Button>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--rose-fonce);
    margin-bottom: 18px;
    font-weight: 500;
  }
  h1 em, h2 em, h3 em { font-style: italic; color: var(--rose-fonce); }

  .method-detail {
    display: flex;
    flex-direction: column;
    gap: 60px;
  }
  .method-detail__step {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 40px;
    align-items: flex-start;
  }
  .method-detail__roman {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 86px;
    line-height: 1;
    color: var(--rose-fonce);
    font-weight: 500;
  }
  .method-detail__body h3 {
    font-size: 1.6rem;
    margin-bottom: 14px;
  }
  .method-detail__body ul {
    list-style: none;
    padding: 0;
    margin: 18px 0;
  }
  .method-detail__body ul li {
    padding: 8px 0 8px 26px;
    position: relative;
    color: var(--anthracite);
  }
  .method-detail__body ul li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--rose-fonce);
    font-weight: 600;
  }
  @media (max-width: 700px) {
    .method-detail__step { grid-template-columns: 1fr; gap: 12px; }
    .method-detail__roman { font-size: 52px; }
  }
</style>
