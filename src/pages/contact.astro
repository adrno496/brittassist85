---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';

const title = "Échanger avec Brittany · BrittAssist";
const description =
  "Trente minutes pour décrire votre organisation actuelle et identifier ce qu’un Private Office pourrait absorber. Rendez-vous en ligne ou message direct.";
---

<BaseLayout title={title} description={description}>
  <header class="hero hero--page">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1 class="hero__title">Parlons de votre organisation actuelle.</h1>
      <p class="hero__sub">
        Trente minutes suffisent. Vous décrivez comment votre semaine se passe
        réellement, j’identifie ce qui peut être absorbé dès le premier mois.
        Aucun cahier des charges à préparer.
      </p>
      <div class="hero__actions btn-row">
        <Button
          href="https://calendly.com/brittassist85/rendez-vous-decouverte"
          external
          variant="ivoire"
        >
          Réserver un créneau
        </Button>
        <Button href="#message" variant="lien">Écrire directement</Button>
      </div>
    </div>
  </header>

  <!-- ── Formulaire ───────────────────────────────────────── -->
  <section class="band band--noir-doux" id="message">
    <div class="container">
      <div class="band__head reveal">
        <p class="eyebrow">Message direct</p>
        <h2>Ou écrivez-moi en trois lignes.</h2>
        <p class="lede">
          Dites-moi simplement ce qui vous prend du temps en ce moment. Je
          reviens vers vous personnellement.
        </p>
      </div>

      <div id="form-sent" class="form-sent" hidden>
        <strong>Message bien reçu.</strong> Je reviens vers vous personnellement,
        depuis&nbsp;<a href="mailto:brittanydreano.cm@gmail.com">brittanydreano.cm@gmail.com</a>.
      </div>

      <form
        class="form reveal"
        data-axdia-form
        data-subject="Demande Private Office (site)"
        action="https://formsubmit.co/brittanydreano.cm%40gmail.com"
        method="POST"
      >
        <input type="hidden" name="_subject" value="Nouvelle demande BrittAssist" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_next" value="https://brittassist.fr/contact?sent=true" />

        <div class="form-row">
          <div class="form-group">
            <label for="firstname">Prénom <span class="required">*</span></label>
            <input type="text" id="firstname" name="prenom" required autocomplete="given-name" />
          </div>
          <div class="form-group">
            <label for="lastname">Nom <span class="required">*</span></label>
            <input type="text" id="lastname" name="nom" required autocomplete="family-name" />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="email">E-mail <span class="required">*</span></label>
            <input type="email" id="email" name="email" required autocomplete="email" />
          </div>
          <div class="form-group">
            <label for="phone">Téléphone <span class="optional">(facultatif)</span></label>
            <input type="tel" id="phone" name="telephone" autocomplete="tel" />
          </div>
        </div>

        <div class="form-group">
          <label for="message">Votre message <span class="required">*</span></label>
          <textarea
            id="message"
            name="message"
            rows="6"
            required
            placeholder="Ce qui vous prend du temps en ce moment, en quelques lignes."
          ></textarea>
        </div>

        <div class="form-check">
          <input type="checkbox" id="rgpd" name="rgpd" required />
          <label for="rgpd">
            <span>
              Je consens au traitement de mes données (nom, e-mail, téléphone)
              dans le seul but de répondre à ma demande.
              <a href="/politique-confidentialite">Politique de confidentialité</a>.
            </span>
          </label>
        </div>

        <Button type="submit" variant="ivoire">Envoyer</Button>
        <p class="form-note">
          Vos informations restent confidentielles et ne sont transmises à
          aucun tiers commercial.
        </p>
      </form>
    </div>
  </section>

  <!-- ── Contact direct ───────────────────────────────────── -->
  <section class="band band--noir band--tight">
    <div class="container">
      <p class="eyebrow reveal">Coordonnées</p>
      <div class="direct reveal">
        <div>
          <span class="direct__label">E-mail</span>
          <a class="direct__value" href="mailto:brittanydreano.cm@gmail.com">
            brittanydreano.cm@gmail.com
          </a>
        </div>
        <div>
          <span class="direct__label">Téléphone</span>
          <a class="direct__value" href="tel:+33667249727">06 67 24 97 27</a>
        </div>
        <div>
          <span class="direct__label">Rendez-vous</span>
          <a
            class="direct__value"
            href="https://calendly.com/brittassist85/rendez-vous-decouverte"
            target="_blank"
            rel="noopener"
          >
            Réserver un créneau ↗
          </a>
        </div>
        <div>
          <span class="direct__label">Cadre</span>
          <span class="direct__value">Vendée (85) · France et international</span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // formsubmit renvoie sur /contact?sent=true après l'envoi de l'e-mail.
  if (new URLSearchParams(window.location.search).get('sent') === 'true') {
    const el = document.getElementById('form-sent');
    if (el) {
      el.hidden = false;
      el.scrollIntoView({ block: 'center' });
    }
  }
</script>
