---
import '../styles/global.css';
import '../styles/refonte-v5.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { lastmodPour, publicationPour } from '../data/dates.mjs';
import { jsonLd } from '../lib/seo';
import { offres, offreStructuree } from '../data/offres';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Texte alternatif de l'image de partage, quand la page fournit la sienne */
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  canonical?: string;
  noindex?: boolean;
  /** Avec noindex : laisser les robots suivre les liens de la page (liste encore vide, par exemple) */
  suivreLiens?: boolean;
  bodyClass?: string;
  datePublished?: string;
  dateModified?: string;
  /** Page en attente de relecture : visible en aperçu seulement, jamais indexable */
  brouillon?: boolean;
  /** Date de relecture humaine (AAAA-MM-JJ), reprise dans les données structurées */
  dateRelecture?: string;
}

const {
  title,
  description,
  ogImage = '/images/og-brittassist.jpg',
  ogImageAlt = 'BrittAssist, assistance de direction externalisée par Brittany Dreano',
  ogType = 'website',
  canonical,
  noindex = false,
  suivreLiens = false,
  bodyClass = '',
  datePublished,
  dateModified,
  brouillon = false,
  dateRelecture,
} = Astro.props;

const siteUrl = 'https://www.brittassist.fr';
// On retire l'extension .html pour que le canonical corresponde aux URLs
// propres servies par Vercel (cleanUrls). L'accueil reste « / ».
const cleanPath = Astro.url.pathname.replace(/\.html$/, '');
const canonicalUrl = canonical ?? new URL(cleanPath, siteUrl).toString();
const ogImageAbs = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

// Date de dernière mise à jour (signal de fraîcheur pour Google et les moteurs
// IA). Valeur fournie par la page, sinon celle déduite du chemin — la même
// source que le <lastmod> du sitemap, pour que les deux ne divergent jamais.
const lastModified = dateModified ?? lastmodPour(cleanPath);
const published = datePublished ?? publicationPour(cleanPath);

---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#FBF8F4" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content={suivreLiens ? 'noindex,follow' : 'noindex,nofollow'} />}
    {brouillon && !noindex && <meta name="robots" content="noindex,follow" />}
    {brouillon && <meta name="statut-editorial" content="brouillon" />}
    <link rel="canonical" href={canonicalUrl} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/images/logo.png" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="BrittAssist" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="fr_FR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <meta name="author" content="Brittany Dreano" />

    {/* Le LCP est du texte : les deux fichiers latins sont préchargés.
        L'attribut crossorigin est requis pour une police, même servie par le site. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/instrument-serif-latin-400-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/manrope-latin-400-normal.woff2"
      crossorigin
    />

    <script type="application/ld+json" set:html={jsonLd({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebSite',
          '@id': `${siteUrl}/#website`,
          url: `${siteUrl}/`,
          name: 'BrittAssist',
          alternateName: 'BrittAssist — Private Office',
          inLanguage: 'fr-FR',
          publisher: { '@id': `${siteUrl}/#business` },
        },
        {
          '@type': ['ProfessionalService', 'LocalBusiness'],
          '@id': `${siteUrl}/#business`,
          name: 'BrittAssist',
          description:
            "Private Office externalisé pour entrepreneurs et dirigeants : executive assistant et lifestyle assistant. Administratif, agenda, déplacements, réservations, coordination et demandes sur mesure, prises en charge de bout en bout.",
          slogan: 'Vous gardez les décisions. J’absorbe le reste.',
          url: `${siteUrl}/`,
          email: 'brittanydreanocm@gmail.com',
          telephone: '+33667249727',
          image: ogImageAbs,
          knowsLanguage: ['fr-FR', 'en'],
          founder: { '@id': `${siteUrl}/a-propos#brittany-dreano` },
          areaServed: [
            { '@type': 'Country', name: 'France' },
            { '@type': 'Place', name: 'International (à distance)' },
          ],
          address: {
            '@type': 'PostalAddress',
            addressLocality: 'La Roche-sur-Yon',
            addressRegion: 'Vendée',
            addressCountry: 'FR',
          },
          sameAs: [
            'https://www.linkedin.com/in/brittassit85/',
            'https://www.instagram.com/brittassist85',
            'https://www.facebook.com/profile.php?id=100091531544199',
          ],
          hasOfferCatalog: {
            '@type': 'OfferCatalog',
            name: 'Accompagnements BrittAssist',
            itemListElement: offres.map(offreStructuree),
          },
        },
        {
          '@type': 'Person',
          '@id': `${siteUrl}/a-propos#brittany-dreano`,
          name: 'Brittany Dreano',
          url: `${siteUrl}/a-propos`,
          image: `${siteUrl}/images/portrait-brittany-parcours.jpg`,
          jobTitle: 'Executive & Lifestyle Assistant',
          worksFor: { '@id': `${siteUrl}/#business` },
        },
        {
          '@type': 'WebPage',
          '@id': `${canonicalUrl}#webpage`,
          url: canonicalUrl,
          name: title,
          description,
          isPartOf: { '@id': `${siteUrl}/#website` },
          about: { '@id': `${siteUrl}/#business` },
          inLanguage: 'fr-FR',
          // Une page sans date de publication (article encore en brouillon) n'en déclare aucune.
          ...(published ? { datePublished: published } : {}),
          dateModified: lastModified,
          primaryImageOfPage: ogImageAbs,
          ...(dateRelecture
            ? { lastReviewed: dateRelecture, reviewedBy: { '@id': `${siteUrl}/a-propos#brittany-dreano` } }
            : {}),
        },
      ],
    })} />

    <slot name="head" />

    {/* Consentement CNIL : Google Analytics n'est chargé qu'après acceptation. */}
    <script src="/consent.js" is:inline></script>
  </head>
  <body class={bodyClass}>
    <div id="progress-bar"></div>

    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <script>
      const bar = document.getElementById('progress-bar');
      if (bar) {
        const updateBar = () => {
          const scrollTop = window.scrollY;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
          bar.style.width = pct + '%';
        };
        updateBar();
        window.addEventListener('scroll', updateBar, { passive: true });
        window.addEventListener('resize', updateBar, { passive: true });
      }

      const reveals = document.querySelectorAll('.reveal, .request__steps');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduced && reveals.length > 0 && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('has-reveal');
        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                obs.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -80px 0px', threshold: 0.05 },
        );
        reveals.forEach((el) => obs.observe(el));
      } else {
        reveals.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
    <script src="/axdia-forms.js" defer is:inline></script>
  </body>
</html>
