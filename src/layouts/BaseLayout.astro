---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { lastmodPour } from '../data/dates.mjs';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
  bodyClass?: string;
  datePublished?: string;
  dateModified?: string;
}

const {
  title,
  description,
  ogImage = '/images/og-brittassist.jpg',
  canonical,
  noindex = false,
  bodyClass = '',
  datePublished = '2026-08-20',
  dateModified,
} = Astro.props;

const siteUrl = 'https://brittassist.fr';
// On retire l'extension .html pour que le canonical corresponde aux URLs
// propres servies par Vercel (cleanUrls). L'accueil reste « / ».
const cleanPath = Astro.url.pathname.replace(/\.html$/, '');
const canonicalUrl = canonical ?? new URL(cleanPath, siteUrl).toString();
const ogImageAbs = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

// Date de dernière mise à jour (signal de fraîcheur pour Google et les moteurs
// IA). Valeur fournie par la page, sinon celle déduite du chemin — la même
// source que le <lastmod> du sitemap, pour que les deux ne divergent jamais.
const lastModified = dateModified ?? lastmodPour(cleanPath);

const FONTS_CSS =
  'https://fonts.bunny.net/css?family=instrument-serif:400,400i|manrope:300,400,500,600&display=swap';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0B0B0B" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonicalUrl} />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/images/logo.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BrittAssist" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:locale" content="fr_FR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <meta name="author" content="Brittany Dreano" />

    {/* Le LCP est du texte : les deux fichiers latins sont préchargés. */}
    <link rel="preconnect" href="https://fonts.bunny.net" crossorigin />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="https://fonts.bunny.net/instrument-serif/files/instrument-serif-latin-400-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="https://fonts.bunny.net/manrope/files/manrope-latin-400-normal.woff2"
      crossorigin
    />
    <link rel="stylesheet" href={FONTS_CSS} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebSite',
          '@id': `${siteUrl}/#website`,
          url: `${siteUrl}/`,
          name: 'BrittAssist',
          alternateName: 'BrittAssist — Private Office',
          inLanguage: 'fr-FR',
          publisher: { '@id': `${siteUrl}/#business` },
        },
        {
          '@type': ['ProfessionalService', 'LocalBusiness'],
          '@id': `${siteUrl}/#business`,
          name: 'BrittAssist',
          description:
            "Private Office externalisé pour entrepreneurs et dirigeants : executive assistant et lifestyle assistant. Administratif, agenda, déplacements, réservations, coordination et demandes sur mesure, prises en charge de bout en bout.",
          slogan: 'Vous gardez les décisions. J’absorbe le reste.',
          url: `${siteUrl}/`,
          email: 'brittanydreano.cm@gmail.com',
          telephone: '+33667249727',
          image: ogImageAbs,
          priceRange: '€€€',
          knowsLanguage: ['fr-FR', 'en'],
          founder: { '@type': 'Person', name: 'Brittany Dreano' },
          areaServed: [
            { '@type': 'Country', name: 'France' },
            { '@type': 'Place', name: 'International (à distance)' },
          ],
          address: {
            '@type': 'PostalAddress',
            addressLocality: 'La Roche-sur-Yon',
            addressRegion: 'Vendée',
            addressCountry: 'FR',
          },
          sameAs: [
            'https://www.linkedin.com/in/brittassit85/',
            'https://www.instagram.com/brittassist85',
            'https://www.facebook.com/profile.php?id=100091531544199',
          ],
          openingHours: 'Mo-Fr 09:00-18:00',
          hasOfferCatalog: {
            '@type': 'OfferCatalog',
            name: 'Accompagnements BrittAssist',
            itemListElement: [
              {
                '@type': 'Offer',
                name: 'Executive Private Office',
                description:
                  "Prise en charge continue du quotidien professionnel et personnel d’un dirigeant : administratif, agenda, déplacements, réservations, coordination, suivi prestataires.",
                price: '700',
                priceCurrency: 'EUR',
                eligibleDuration: {
                  '@type': 'QuantitativeValue',
                  value: 1,
                  unitCode: 'MON',
                },
              },
              {
                '@type': 'Offer',
                name: 'Private Office sur mesure',
                description:
                  "Disponibilité renforcée, plusieurs entreprises, forte volumétrie, déplacements fréquents, coordination quotidienne.",
              },
              {
                '@type': 'Offer',
                name: 'Mission ponctuelle',
                description:
                  "Voyage, événement, recherche ou organisation spécifique, sans récurrence.",
              },
            ],
          },
        },
        {
          '@type': 'WebPage',
          '@id': `${canonicalUrl}#webpage`,
          url: canonicalUrl,
          name: title,
          description,
          isPartOf: { '@id': `${siteUrl}/#website` },
          about: { '@id': `${siteUrl}/#business` },
          inLanguage: 'fr-FR',
          datePublished,
          dateModified: lastModified,
          primaryImageOfPage: ogImageAbs,
        },
      ],
    })} />

    <slot name="head" />

    {/* Consentement CNIL : Google Analytics n'est chargé qu'après acceptation. */}
    <script src="/consent.js" is:inline></script>
  </head>
  <body class={bodyClass}>
    <div id="progress-bar"></div>

    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <script>
      const bar = document.getElementById('progress-bar');
      if (bar) {
        const updateBar = () => {
          const scrollTop = window.scrollY;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
          bar.style.width = pct + '%';
        };
        updateBar();
        window.addEventListener('scroll', updateBar, { passive: true });
        window.addEventListener('resize', updateBar, { passive: true });
      }

      const reveals = document.querySelectorAll('.reveal, .request__steps');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduced && reveals.length > 0 && 'IntersectionObserver' in window) {
        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                obs.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -80px 0px', threshold: 0.05 },
        );
        reveals.forEach((el) => obs.observe(el));
      } else {
        reveals.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
    <script src="/axdia-forms.js" defer is:inline></script>
  </body>
</html>
